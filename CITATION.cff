      given-names: "Chris"
    - family-names: "Epperly"
      given-names: "Ethan N."
    - family-names: "Tropp"
      given-names: "Joel A."
  journal: "Quantum"
  volume: 10
  start: 2022
  year: 2026
  doi: "10.22331/q-2026-03-10-2022"
  url: "https://doi.org/10.22331/q-2026-03-10-2022"
